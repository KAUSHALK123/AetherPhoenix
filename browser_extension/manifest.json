{
  "manifest_version": 3,
  "name": "AetherPhoenix Browser Agent",
  "version": "1.0.0",
  "description": "Connects user browser to AetherPhoenix AI Desktop Assistant for visible controlled automation.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AetherPhoenix Browser Agent"
  }
}
