# AetherPhoenix Backend Configuration Template
# Copy this file to .env for local runtime configuration.

# Application Settings
PROJECT_NAME="AetherPhoenix"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=False
API_V1_STR="/api/v1"

# Server & Security Settings
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="generate-secure-random-secret-key-for-production"
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Settings
DATABASE_URL="sqlite:///./aether_phoenix.db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

# Logging Settings
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_FILE="aether_phoenix.log"
LOG_FORMAT_JSON=True
LOG_CONSOLE_ENABLED=True
LOG_FILE_ENABLED=True

# Execution Infrastructure
MAX_WORKERS=4
EXECUTION_TIMEOUT_SECONDS=300
PERMISSION_TIMEOUT_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=30

# Path Settings
DATA_DIR="data"
ARTIFACTS_DIR="artifacts"
TEMP_DIR="tmp"
WORKSPACE_DIR="workspace"
